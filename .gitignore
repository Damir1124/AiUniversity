# Common
*.log
.DS_Store
Thumbs.db

# Vault / Obsidian настроек не коммитим, КРОМЕ установленных community-плагинов
# (чтобы при клонировании на телефон плагин был сразу доступен)
.obsidian/*
!.obsidian/plugins/
.obsidian/plugins/*
!.obsidian/plugins/obsidian-git/
!.obsidian/plugins/obsidian-git/*

# Источники/большие файлы — по желанию исключить
# raw/binaries/**
# *.dat
# *.exe
# *.dll

# dsh
.dsh/

# Большие PDF-исходники (обрабатываются локально, НЕ грузятся на GitHub >100MB limit)
raw/*.PDF
raw/*.pdf
raw/**/*.pdf
raw/**/*.PDF

# Python-конвертер: временные файлы и библиотеки не коммитим.
# Библиотеки восстанавливаются скриптом _scripts/install_lib.py (см. _scripts/README.md)
_scripts/lib/
_scripts/_pipsrc/
_scripts/_pycache/
__pycache__/
